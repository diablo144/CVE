# Copy to .env and replace every placeholder before deployment.
# Never commit the real .env file.

RR_APP_NAME=reconrelay
RR_DEBUG=false

# Use at least 32 random bytes for each value; keep the API key private.
RR_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
RR_API_KEYS=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_API_KEY
RR_JWT_TTL_SECONDS=28800

# Required: comma-separated domains, *.subdomains, or CIDRs you own / have
# written authorization to test. Empty means all scan jobs are rejected.
RR_AUTHORIZED_SCOPES=example.com,*.example.com
RR_ALLOW_ANY_SCOPE=false
RR_ALLOW_ACTIVE_MODULES=false
RR_DEFAULT_PRESET=recon
RR_MAX_EVENTS_PER_SCAN=2500
RR_MAX_DEPTH=4
RR_SCAN_TIMEOUT_SECONDS=600

# API + worker share Redis; memory mode is only for local dev/tests.
RR_REDIS_URL=redis://redis:6379/0
RR_USE_MEMORY_STORE=false
RR_INLINE_WORKER=false
RR_WORKER_CONCURRENCY=1
RR_WORKER_POLL_INTERVAL=0.5

# The extension uses the MV3 chrome-extension://<32 chars> origin.
RR_CORS_ORIGINS=chrome-extension://*
RR_CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
